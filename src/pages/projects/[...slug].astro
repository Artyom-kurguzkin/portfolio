---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { Content } = await render(project);
const p = project.data;

// public/ paths in front matter are written from the site root
const url = (path: string) => `${import.meta.env.BASE_URL}${path.replace(/^\//, '')}`;
const date = p.date.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
// facts table under the hero text; rows without a value are skipped
const facts: [string, string | undefined][] = [
	['Date', date],
	['Role', p.role],
	['Contributors', p.contributors.join(', ') || undefined],
];
---

<Layout title={p.title} description={p.summary}>
	<a class="back" href={`${import.meta.env.BASE_URL}`} aria-label="Back to main page">&larr;</a>

	<!-- Layout follows local design notes: context first, core ideas, challenge → approach,
	     modules piece by piece, outcome last. Hero is built from front matter, the rest from the body. -->
	<article class="panel project">
		<header class="hero">
			<div class="hero-text">
				<dl class="facts">
					{
						facts
							.filter(([, v]) => v)
							.map(([k, v]) => (
								<div>
									<dt>{k}</dt>
									<dd>{v}</dd>
								</div>
							))
					}
					{
						p.link && (
							<div>
								<dt>Link</dt>
								<dd>
									<a href={p.link}>{p.link.replace(/^https?:\/\//, '')}</a>
								</dd>
							</div>
						)
					}
				</dl>
				<h1>{p.title}</h1>
				<p class="tagline">{p.summary}</p>
				{p.context && <p class="context">{p.context}</p>}
			</div>
			{
				p.video ? (
					<video
						class="hero-image"
						src={url(p.video)}
						poster={p.image && url(p.image)}
						autoplay
						muted
						loop
						playsinline
						aria-hidden="true"
					/>
				) : (
					p.image && <img class="hero-image" src={url(p.image)} alt="" />
				)
			}
		</header>

		<div class="body">
			{
				p.stack.length > 0 && (
					<section class="tools">
						<h2>Applied tools</h2>
						<p>{p.stack.join('; ')}</p>
					</section>
				)
			}
			<Content />
		</div>
	</article>
</Layout>

<script>
	// The autoplay attribute alone is refused often enough (power saving, a background tab
	// on load) that it's worth asking directly; the poster stays if the answer is no.
	const clip = document.querySelector<HTMLVideoElement>('video.hero-image');
	if (clip) {
		const start = () => clip.play().catch(() => {});
		start();
		clip.addEventListener('canplay', start, { once: true });
	}
</script>

<style>
	.project {
		--pad: clamp(1.25rem, 5vw, 2.5rem); /* same as .panel padding; the hero image bleeds by it */
		max-width: 68rem;
	}

	/* --- hero --- */
	.hero {
		display: flex;
		flex-direction: column;
		padding-bottom: 2rem;
		border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent);
	}

	/* narrow: the image is a cover across the top of the card, edge to edge */
	.hero-image {
		order: -1;
		width: calc(100% + 2 * var(--pad));
		max-width: none;
		margin: calc(-1 * var(--pad)) calc(-1 * var(--pad)) 1.5rem;
		aspect-ratio: 3 / 4; /* hero images are portrait (they also fill the tall desktop column) */
		object-fit: cover;
		object-position: center top;
		border-radius: var(--radius-lg) var(--radius-lg) 0 0;
	}

	/* wide: text left, image fills the card's top-right corner to its edges */
	@media (min-width: 60rem) {
		.hero:has(.hero-image) {
			display: grid;
			grid-template-columns: 1.15fr 1fr;
			gap: 2.5rem;
			margin: calc(-1 * var(--pad)) calc(-1 * var(--pad)) 0 0;
			padding-bottom: 0;
			border-bottom: none;
		}

		.hero:has(.hero-image) .hero-text {
			align-self: center;
			padding: var(--pad) 0 2rem;
		}

		.hero-image {
			order: 0;
			width: 100%;
			height: 100%;
			min-height: 34rem;
			margin: 0;
			aspect-ratio: auto;
			border-radius: 0 var(--radius-lg) 0 var(--radius-md);
		}
	}

	h1 {
		color: var(--color-blue);
		margin-bottom: 0.25rem;
	}

	.tagline {
		margin: 0 0 1.25rem;
		font-size: 1.15rem;
		font-weight: 700;
	}

	.context {
		margin: 0 0 1.5rem;
	}

	/* facts: one wrapping row of "LABEL value" pairs above the title */
	.facts {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 1.75rem;
		margin: 0 0 1.5rem;
		font-size: 0.85rem;
	}

	.facts div {
		display: flex;
		gap: 0.5rem;
		align-items: baseline;
		min-width: 0;
	}

	.facts dt {
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	.facts dd {
		margin: 0;
		color: var(--color-muted);
		overflow-wrap: anywhere;
	}

	/* --- body: written in the project's markdown, full card width --- */
	/* section titles: Core ideas, Challenge, Approach, How it works, Outcome */
	.body :global(h2) {
		margin: 2.75rem 0 0.75rem;
		color: var(--color-green);
	}

	/* small arrow labels for each idea / module, like caption headings in a print spread */
	.body :global(h3) {
		margin: 1.75rem 0 0.35rem;
		font-family: var(--font-body);
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.body :global(h3)::before {
		content: '→ ';
		color: var(--color-green);
	}

	/* a list straight under a section title whose items start with **Term** (Core ideas):
	   term in a left column, explanation beside it, thin rule between rows */
	.body > :global(h2 + ul) {
		padding: 0;
		list-style: none;
	}

	.body > :global(h2 + ul li) {
		position: relative;
		padding: 0.75rem 0;
		border-top: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent);
	}

	.body > :global(h2 + ul li strong:first-child) {
		display: block;
		color: var(--color-ink);
	}

	@media (min-width: 40rem) {
		.body > :global(h2 + ul li:has(> strong:first-child)) {
			padding-left: 15rem;
		}

		.body > :global(h2 + ul li strong:first-child) {
			position: absolute;
			left: 0;
			width: 14rem;
		}
	}

	/* images and videos; an italic line right after is the caption */
	.body :global(video) {
		display: block;
		width: 100%;
		max-width: 40rem;
		max-height: 70vh;
		border-radius: var(--radius-md);
		margin: 1.25rem auto 0.5rem;
		background: #000;
	}

	/* tall images (diagrams) are capped to the screen height and centred instead of filling the width */
	.body :global(img) {
		display: block;
		width: auto;
		max-width: 100%;
		max-height: 80vh;
		margin-inline: auto !important;
		height: auto;
		border-radius: var(--radius-md);
		margin: 1.25rem 0 0.5rem;
	}

	.body :global(:is(p:has(> img), video) + p > em:only-child) {
		display: block;
		font-size: 0.85rem;
		color: var(--color-muted);
	}

</style>
