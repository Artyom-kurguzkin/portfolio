---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SectionCards from '../../components/SectionCards.astro';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { Content } = await render(project);
const p = project.data;

// public/ paths in front matter are written from the site root
const url = (path: string) => `${import.meta.env.BASE_URL}${path.replace(/^\//, '')}`;
const date = p.date.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
// facts table under the hero text; rows without a value are skipped
const facts: [string, string | undefined][] = [
	['Date', date],
	['Role', p.role],
	['Contributors', p.contributors.join(', ') || undefined],
	['Tools', p.stack.join('; ') || undefined],
];
---

<Layout title={p.title} description={p.summary}>
	<a class="back" href={`${import.meta.env.BASE_URL}`} aria-label="Back to main page"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" /></svg></a>

	<!-- Layout follows local design notes: context first, core ideas, challenge → approach,
	     modules piece by piece, outcome last. Hero is built from front matter, the rest from the body. -->
	<!-- separate cards, like the main page, laid out by SectionCards: the overview (hero beside
	     Core ideas), then Challenges and the rest of the markdown in rows of cards -->
	<article class="board">
		<SectionCards>
			<header slot="hero" class="panel hero">
				<div class="hero-text">
					<dl class="facts">
						{
							facts
								.filter(([, v]) => v)
								.map(([k, v]) => (
									<div>
										<dt>{k}</dt>
										<dd>{v}</dd>
									</div>
								))
						}
						{
							p.link && (
								<div>
									<dt>Link</dt>
									<dd>
										<a href={p.link}>{p.link.replace(/^https?:\/\//, '')}</a>
									</dd>
								</div>
							)
						}
					</dl>
					<h1>{p.title}</h1>
					<p class="tagline">{p.summary}</p>
					{p.context && <p class="context">{p.context}</p>}
				</div>
				{
					p.video ? (
						<video
							class="hero-image"
							src={url(p.video)}
							poster={p.image && url(p.image)}
							autoplay
							muted
							loop
							playsinline
							aria-hidden="true"
						/>
					) : (
						p.image && <img class="hero-image" src={url(p.image)} alt="" />
					)
				}
				{(p.video || p.image) && <span class="zoom-badge" aria-hidden="true" />}
			</header>
	
			<Content />
		</SectionCards>
	</article>
</Layout>

<script>
	// The autoplay attribute alone is refused often enough (power saving, a background tab
	// on load) that it's worth asking directly; the poster stays if the answer is no.
	const clip = document.querySelector<HTMLVideoElement>('video.hero-image');
	if (clip) {
		const start = () => clip.play().catch(() => {});
		start();
		clip.addEventListener('canplay', start, { once: true });
	}

	// Justified fit inside a card, so nothing leaves empty space beside or under it:
	// - side by side, when some text width w makes the text exactly as tall as the pictures
	//   scaled to fill the rest of the card's width (code blocks keep their size)
	// - otherwise (short text next to wide pictures can never be that tall) the text runs
	//   across the top and the pictures form one row below, all the same height, filling the
	//   card's width
	// Pictures never grow past MAX_H (see balance). Re-run on resize and as pictures load.
	const PAGE_MAX_H = 560;
	const MIN_TEXT = 288; // 18rem
	const wide = matchMedia('(min-width: 60rem)');
	const balance = (card: HTMLElement) => {
		const text = card.querySelector<HTMLElement>(':scope > .item.text')!;
		const items = [...card.children] as HTMLElement[];
		card.classList.remove('stacked');
		items.forEach((el) => {
			el.style.flex = '';
			el.style.maxWidth = '';
		});
		if (!wide.matches) return;
		const pics = items.filter((el) => el !== text && el.querySelector('img, video'));
		const code = items.filter((el) => el !== text && !pics.includes(el));
		if (!pics.length) return; // text beside code: the estimate from SectionCards holds
		const media = (el: HTMLElement) => el.querySelector<HTMLImageElement & HTMLVideoElement>('img, video')!;
		const ratio = (el: HTMLElement) => {
			const m = media(el);
			return (m.naturalWidth || m.videoWidth || 16) / (m.naturalHeight || m.videoHeight || 9);
		};
		const ratios = pics.map(ratio);
		const sumRatio = ratios.reduce((a, b) => a + b, 0);
		// pictures are exported at ~2x: never shown taller than 60% of their pixels (beyond that a
		// diagram's lettering just gets huge), and never past MAX_H
		const MAX_H = Math.min(
			PAGE_MAX_H,
			+(card.dataset.maxH ?? Infinity), // set by fitPictures when the text is too short for the pictures
			...pics.map((el) => {
				const m = media(el);
				return (m.naturalHeight || m.videoHeight || 1e4) * 0.6;
			})
		);
		const caption = Math.max(...pics.map((el) => el.offsetHeight - media(el).offsetHeight));
		const gap = parseFloat(getComputedStyle(card).columnGap) || 0;
		const inner = card.clientWidth - parseFloat(getComputedStyle(card).paddingLeft) * 2;
		const codeWidth = code.reduce((sum, el) => sum + el.offsetWidth + gap, 0);
		const setPics = (h: number) =>
			pics.forEach((el, i) => {
				el.style.flex = `0 0 ${h * ratios[i]}px`;
				el.style.maxWidth = 'none';
			});

		// text that's only a title: title on top, pictures below
		if (!text.querySelector('p, ul, ol')) {
			card.classList.add('stacked');
			text.style.flex = '0 0 100%';
			const h = Math.min(MAX_H, (inner - gap * (pics.length - 1)) / sumRatio);
			setPics(h);
			if (pics.length === 1 && h < MAX_H - 1) pics[0].style.flex = '0 0 100%';
			return h < MAX_H - 1;
		}

		// side by side: pictures get room - w, so their height is (room - w) / sumRatio
		const room = inner - codeWidth - gap * pics.length;
		let best: { w: number; h: number } | undefined;
		for (let w = MIN_TEXT; w <= room - 120 * pics.length; w += 8) {
			text.style.flex = `0 0 ${w}px`;
			const h = (room - w) / sumRatio;
			if (h > MAX_H) continue;
			if (text.offsetHeight <= h + caption) {
				best = { w, h };
				break; // narrowest text that fits beside: the biggest pictures
			}
		}
		// accept only when the text comes out about as tall as the pictures
		if (best && best.h >= 200) {
			text.style.flex = `0 0 ${best.w}px`;
			if (text.offsetHeight >= 0.8 * (best.h + caption)) {
				setPics(best.h);
				return true;
			}
		}

		// stacked: text (and any code beside it) across the top, then one row of pictures
		// filling the width
		const rowHeight = Math.min(MAX_H, (inner - codeWidth - gap * (pics.length - 1)) / sumRatio);
		const rowWidth = rowHeight * sumRatio + gap * (pics.length - 1);
		if (rowHeight >= MAX_H - 1) {
			// the pictures can't fill the width: either way some space stays empty, so compare
			// the strip beside the stacked pictures with the strip under the text beside them
			const besideEmpty = (inner - rowWidth) * rowHeight;
			const w = room - MAX_H * sumRatio;
			if (w >= MIN_TEXT) {
				text.style.flex = `0 0 ${w}px`;
				const underEmpty = Math.max(0, MAX_H + caption - text.offsetHeight) * w;
				if (underEmpty <= besideEmpty) {
					setPics(MAX_H);
					return underEmpty < 0.1 * (MAX_H + caption) * w; // fits unless a strip stays empty
				}
			}
		}
		card.classList.add('stacked');
		text.style.flex = '0 0 100%'; // across the top; any code sits in the picture row, beside the pictures
		setPics(rowHeight);
		// a single picture under the text simply spans the card (a video needs the width for its controls)
		if (pics.length === 1 && rowHeight < MAX_H - 1) pics[0].style.flex = '0 0 100%';
		return rowHeight < MAX_H - 1; // the pictures fill the width
	};

	// A picture card whose text is too short for its pictures: the pictures shrink to the text's
	// height (they can still be zoomed), so every section keeps its own card.
	const fitPictures = (card: HTMLElement) => {
		const text = card.querySelector<HTMLElement>(':scope > .item.text');
		if (!text || card.children.length < 2) return true;
		if (balance(card)) return true;
		card.dataset.maxH = String(Math.max(280, text.offsetHeight - 40));
		return balance(card);
	};
	// Rows: a card with pictures takes a row of its own (fitted above); other cards go two to a
	// row, and the two widths are chosen so both cards come out the same height: find the
	// smallest height H both can reach within the row's width. Inside such a card, text sits
	// beside its code block, or above it when the card is too narrow for both.
	const layoutInner = (card: HTMLElement) => {
		const text = card.querySelector<HTMLElement>(':scope > .item.text');
		const code = [...card.children].filter((el) => el !== text) as HTMLElement[];
		if (!text) return;
		text.style.flex = '1 1 0';
		code.forEach((el) => {
			el.style.flex = '0 0 auto';
			el.style.maxWidth = '100%';
		});
		if (!code.length) return;
		card.classList.remove('stacked');
		const gap = parseFloat(getComputedStyle(card).columnGap) || 0;
		const inner = card.clientWidth - parseFloat(getComputedStyle(card).paddingLeft) * 2;
		const codeWidth = code.reduce((sum, el) => sum + el.offsetWidth + gap, 0);
		if (inner - codeWidth < MIN_TEXT) {
			card.classList.add('stacked');
			text.style.flex = '0 0 100%';
		}
	};
	// measured with stretching off: a row stretches every card to its tallest one
	const heightAt = (card: HTMLElement, w: number) => {
		card.style.flex = `0 0 ${w}px`;
		card.style.alignSelf = 'flex-start';
		if (card.classList.contains('pics')) balance(card);
		else layoutInner(card);
		const h = card.offsetHeight;
		card.style.alignSelf = '';
		return h;
	};
	// Cards keep their reading order in data-order, so columns can be taken apart again.
	document.querySelectorAll('.flow > .card').forEach((c, i) => ((c as HTMLElement).dataset.order = String(i)));
	// merged cards (see layoutFlows), undone at the start of every layout pass
	const merges: { card: HTMLElement; text: HTMLElement; title: Element[]; pics: HTMLElement[] }[] = [];
	const unwrap = (flow: HTMLElement) => {
		for (const m of merges.splice(0).filter((m) => flow.contains(m.card))) {
			m.text.append(...m.title);
			m.card.append(...m.pics);
			m.card.style.display = '';
		}
		flow.querySelectorAll(':scope > .col').forEach((col) => col.replaceWith(...col.children));
		const cards = ([...flow.children] as HTMLElement[]).sort((a, b) => +a.dataset.order! - +b.dataset.order!);
		flow.append(...cards);
		return cards;
	};
	// After a row is laid out, its shorter columns still have room at the bottom: the next
	// cards are stacked under the column with the most room, as long as each fits there (a
	// little overflow is fine, it only stretches the others). Columns end at the row's bottom.
	const STACK_SLACK = 200; // a card overflowing the gap by up to this much still goes in: a taller row beats an empty strip
	const stackUnder = (row: HTMLElement[], rest: HTMLElement[], gap: number) => {
		const cols = row.map((card) => {
			const col = document.createElement('div');
			col.className = 'col';
			col.style.flex = card.style.flex;
			card.style.flex = '0 0 auto';
			card.before(col);
			col.append(card);
			return col;
		});
		const natural = (col: HTMLElement) =>
			[...col.children].reduce((sum, el) => sum + (el as HTMLElement).offsetHeight, 0) + gap * (col.children.length - 1);
		let taken = 0;
		const fit = (card: HTMLElement) => (card.classList.contains('pics') ? balance(card) : layoutInner(card));
		for (const card of rest) {
			const heights = cols.map(natural);
			const target = Math.max(...heights);
			const i = heights.indexOf(Math.min(...heights));
			const free = target - heights[i] - gap;
			if (free < 120) break;
			cols[i].append(card);
			card.style.flex = '0 0 auto';
			fit(card);
			if (card.offsetHeight > free + STACK_SLACK) {
				cols.at(-1)!.after(card); // doesn't fit: back to where it was
				card.style.flex = card.classList.contains('pics') ? '1 1 100%' : '';
				fit(card);
				break;
			}
			taken++;
		}
		cols.forEach((col) => ((col.lastElementChild as HTMLElement).style.flex = '1 1 auto'));
		return taken;
	};
	// height of a picture card fitted at width w (row stretching off)
	const picsHeightAt = (card: HTMLElement, w: number) => {
		card.style.flex = `0 0 ${w}px`;
		card.style.alignSelf = 'flex-start';
		balance(card);
		const h = card.offsetHeight;
		card.style.alignSelf = '';
		return h;
	};
	// a text card beside a picture card that can't fill a row: split the width so both come out
	// the same height (the text card gets taller as it narrows, the picture card shorter as it widens)
	const pairWithPics = (text: HTMLElement, pics: HTMLElement, full: number, gap: number) => {
		const room = full - gap;
		let lo = 320;
		let hi = Math.max(lo, room - 480);
		for (let i = 0; i < 12; i++) {
			const mid = (lo + hi) / 2;
			if (heightAt(text, mid) > picsHeightAt(pics, room - mid)) lo = mid;
			else hi = mid;
		}
		const diff = heightAt(text, hi) - picsHeightAt(pics, room - hi);
		// only a real pair: about equally tall. Otherwise both take the full width, one under the other.
		if (Math.abs(diff) < 60) return true;
		text.style.flex = pics.style.flex = '1 1 100%';
		layoutInner(text);
		balance(pics);
		return false;
	};
	// Cards without pictures go into k columns, in reading order down each column. For each k,
	// the cards are split (in order) so the columns come out as even as possible, then the column
	// widths are solved so all columns end at the same height. The k that leaves the least empty
	// area wins; a column's last card stretches to the shared bottom.
	const makeCol = (cards: HTMLElement[]) => {
		const col = document.createElement('div');
		col.className = 'col';
		cards[0].before(col);
		col.append(...cards);
		cards.forEach((c) => (c.style.flex = '0 0 auto'));
		return col;
	};
	const colHeightAt = (col: HTMLElement, w: number, gap: number) => {
		col.style.flex = `0 0 ${w}px`;
		col.style.alignSelf = 'flex-start';
		const cards = [...col.children] as HTMLElement[];
		cards.forEach((c) => {
			c.style.flex = '0 0 auto';
			layoutInner(c);
		});
		const h = cards.reduce((sum, c) => sum + c.offsetHeight, 0) + gap * (cards.length - 1);
		col.style.alignSelf = '';
		return h;
	};
	// split heights into k contiguous groups, minimising the tallest group
	const partition = (heights: number[], k: number, gap: number) => {
		const n = heights.length;
		const sum = (a: number, b: number) => heights.slice(a, b).reduce((x, y) => x + y, 0) + gap * (b - a - 1);
		const best: number[][] = Array.from({ length: k + 1 }, () => Array(n + 1).fill(Infinity));
		const cut: number[][] = Array.from({ length: k + 1 }, () => Array(n + 1).fill(0));
		best[0][0] = 0;
		for (let j = 1; j <= k; j++)
			for (let b = j; b <= n; b++)
				for (let a = j - 1; a < b; a++) {
					const v = Math.max(best[j - 1][a], sum(a, b));
					if (v < best[j][b]) {
						best[j][b] = v;
						cut[j][b] = a;
					}
				}
		const groups: number[][] = [];
		for (let j = k, b = n; j > 0; j--) {
			const a = cut[j][b];
			groups.unshift([a, b]);
			b = a;
		}
		return groups;
	};
	const packColumns = (run: HTMLElement[], full: number, gap: number, maxCols: number) => {
		if (!run.length) return;
		if (run.length === 1) {
			run[0].style.flex = '1 1 100%';
			layoutInner(run[0]);
			return;
		}
		// candidate splits: every way to cut a short run into columns (the most even split isn't
		// always the least empty one); a long run falls back to the most even split per k
		const options: number[][][] = [];
		const n = run.length;
		if (n <= 7) {
			for (let mask = 0; mask < 1 << (n - 1); mask++) { // mask 0: one full-width column (last resort)
				const cuts = [0];
				for (let i = 1; i < n; i++) if (mask & (1 << (i - 1))) cuts.push(i);
				cuts.push(n);
				if (cuts.length - 1 > maxCols) continue;
				options.push(cuts.slice(0, -1).map((a, i) => [a, cuts[i + 1]]));
			}
		} else
			for (let k = 2; k <= Math.min(n, maxCols); k++) {
				const w = (full - gap * (k - 1)) / k;
				options.push(partition(run.map((c) => heightAt(c, w)), k, gap));
			}
		// a card with only a line or two never takes a column of its own: it stacks with a neighbour
		const tiny = run.map((c) => heightAt(c, 300) < 220);
		const usable = options.filter((g) => g.every(([a, b]) => b - a > 1 || !tiny[a]));
		let best: { groups: number[][]; widths: number[]; empty: number } | undefined;
		for (const groups of usable.length ? usable : options) {
			const cols = groups.map(([a, b]) => makeCol(run.slice(a, b)));
			const room = full - gap * (cols.length - 1);
			// narrowest width at which the column is no taller than h
			const widthFor = (col: HTMLElement, h: number, max: number) => {
				if (colHeightAt(col, max, gap) > h) return max + 1;
				let lo = 300;
				let hi = max;
				for (let i = 0; i < 9; i++) {
					const mid = (lo + hi) / 2;
					if (colHeightAt(col, mid, gap) > h) lo = mid;
					else hi = mid;
				}
				return hi;
			};
			const max = room - 300 * (cols.length - 1);
			let lo = Math.max(...cols.map((c) => colHeightAt(c, max, gap)));
			let hi = Math.max(...cols.map((c) => colHeightAt(c, 300, gap)));
			for (let i = 0; i < 9; i++) {
				const mid = (lo + hi) / 2;
				if (cols.reduce((sum, c) => sum + widthFor(c, mid, max), 0) > room) lo = mid;
				else hi = mid;
			}
			const widths = cols.map((c) => Math.min(widthFor(c, hi, max), max));
			// leftover width goes to the column that sets the row's height (it can't get shorter
			// anyway); giving it to another would only shorten that one and leave a gap under it
			const atWidth = cols.map((c, i) => colHeightAt(c, widths[i], gap));
			widths[atWidth.indexOf(Math.max(...atWidth))] += room - widths.reduce((a, b) => a + b, 0);
			const heights = cols.map((c, i) => colHeightAt(c, widths[i], gap));
			const rowH = Math.max(...heights);
			const empty = heights.reduce((sum, h, i) => sum + (rowH - h) * widths[i], 0);
			// one full-width column only wins when every side-by-side split leaves a real gap
			// (over 120px under some column); otherwise the side-by-side split with least empty area
			const gapPx = rowH - Math.min(...heights);
			const score = groups.length === 1 ? 1e9 : gapPx > 120 ? 1e9 + empty : empty;
			if (!best || score < best.empty) best = { groups, widths, empty: score };
			cols.forEach((col) => col.replaceWith(...col.children));
		}
		const cols = best!.groups.map(([a, b]) => makeCol(run.slice(a, b)));
		cols.forEach((col, i) => {
			col.style.flex = `0 0 ${best!.widths[i] - 0.5}px`;
			[...col.children].forEach((c) => layoutInner(c as HTMLElement));
			(col.lastElementChild as HTMLElement).style.flex = '1 1 auto';
		});
	};
	// biggest empty strip inside a card: under each item, down to the card's content bottom, past
	// whatever else sits in the same horizontal band
	const innerGap = (card: HTMLElement) => {
		const pad = parseFloat(getComputedStyle(card).paddingBottom);
		const bottom = card.getBoundingClientRect().bottom - pad;
		const items = [...card.children].map((el) => el.getBoundingClientRect());
		return Math.max(
			0,
			...items.map((r) => bottom - Math.max(...items.filter((o) => o.left < r.right && o.right > r.left).map((o) => o.bottom)))
		);
	};
	const layoutFlows = () => {
		document.querySelectorAll<HTMLElement>('.flow').forEach((flow) => {
			const all = unwrap(flow);
			if (!wide.matches) {
				all.forEach((c) => {
					c.style.flex = '';
					c.classList.remove('stacked');
					[...c.children].forEach((el) => ((el as HTMLElement).style.flex = ''));
				});
				return;
			}
			const full = flow.clientWidth;
			const gap = parseFloat(getComputedStyle(flow).columnGap) || 0;
			const unfilled = new Set<HTMLElement>();
			all.filter((c) => c.classList.contains('pics')).forEach((c) => {
				if (!c.isConnected || c.style.display === 'none') return; // hidden: merged or gap-filled
				c.style.flex = '1 1 100%';
				if (fitPictures(c)) return;
				// a section that's only a title and pictures, after a card with pictures: its title
				// and pictures join that card's picture row, so neither card is left half empty
				const text = c.querySelector<HTMLElement>(':scope > .item.text');
				const prev = c.previousElementSibling as HTMLElement | null;
				if (text && !text.querySelector('p, ul, ol') && prev?.classList.contains('pics')) {
					const pics = [...c.children].filter((el) => el !== text) as HTMLElement[];
					const title = [...text.children];
					pics[0].prepend(...title);
					prev.append(...pics);
					c.style.display = 'none';
					merges.push({ card: c, text, title, pics });
					if (fitPictures(prev)) {
						unfilled.delete(prev);
						return;
					}
				}
				unfilled.add(c);
			});
			// rows of cards without pictures: start with two, and keep taking the next card while
			// the row can't use its full width (and each card still gets at least 320px)
			const maxPerRow = Math.max(1, Math.floor((full + gap) / (320 + gap)));
			const cards = [...flow.children] as HTMLElement[];
			let i = 0;
			while (i < cards.length) {
				if (cards[i].style.display === 'none') {
					i++; // merged into the card before it
					continue;
				}
				if (cards[i].classList.contains('pics')) {
					// two picture cards in a row that each can't fill the width (their pictures stop
					// growing first) share a row, splitting it in proportion to what they hold
					const pair = cards[i + 1];
					// two picture cards where either can't fill a row on its own: try sharing one
					if (
						pair &&
						pair.classList.contains('pics') &&
						(unfilled.has(cards[i]) || unfilled.has(pair)) &&
						pair.style.display !== 'none'
					) {
						const want = (c: HTMLElement) =>
							[...c.children].reduce((sum, el) => sum + (el as HTMLElement).getBoundingClientRect().width, 0) + 160;
						const [a, b] = [want(cards[i]), want(pair)];
						// start from a split in proportion, then move it until both come out equally tall
						const room = full - gap;
						let lo = Math.max(320, room * 0.25);
						let hi = Math.min(room - 320, room * 0.75);
						let w = (room * a) / (a + b);
						for (let k = 0; k < 10; k++) {
							const diff = picsHeightAt(cards[i], w) - picsHeightAt(pair, room - w);
							if (Math.abs(diff) < 8) break;
							if (diff > 0) lo = w; // the first is taller: widen it so it gets shorter
							else hi = w;
							w = (lo + hi) / 2;
						}
						picsHeightAt(cards[i], w);
						picsHeightAt(pair, room - w);
						if (Math.max(innerGap(cards[i]), innerGap(pair)) < 120) {
							i += 2;
							continue;
						}
						// pairing leaves empty space inside a card: the first takes a full row, and the
						// second gets its own chance with the card after it
						cards[i].style.flex = pair.style.flex = '1 1 100%';
						balance(cards[i]);
						balance(pair);
						i += 1;
						continue;
					}
					const card = cards[i++];
					const next = cards[i];
					// a picture card that can't fill a full row (its text is too short) narrows to its
					// pictures plus a text column, and the following cards stack in the space beside it
					if (unfilled.has(card) && next && !next.classList.contains('pics')) {
						if (pairWithPics(next, card, full, gap)) {
							i++;
							i += stackUnder([card, next], cards.slice(i), gap);
						}
					}
					continue;
				}
				// a card right before a picture card that can't fill a row: the picture card narrows
				// and this card (and any that fit under it later) takes the space on its left
				const after = cards[i + 1];
				if (after && unfilled.has(after)) {
					const card = cards[i];
					if (pairWithPics(card, after, full, gap)) {
						i += 2;
						i += stackUnder([card, after], cards.slice(i), gap);
					} else i++; // card laid full width; the picture card is handled next
					continue;
				}
				// a run of cards without pictures: laid out as columns (see packColumns)
				const run: HTMLElement[] = [];
				while (i < cards.length && !cards[i].classList.contains('pics') && !(cards[i + 1] && unfilled.has(cards[i + 1]) && run.length)) run.push(cards[i++]);
				packColumns(run, full, gap, maxPerRow);
			}
		});
		markZoomable(); // laid out after this script has run, so it's defined by then
	};
	// Top row on big monitors: hero and Core ideas side by side. The hero's height comes from its
	// text (its image is size-contained), so the split is searched until both are equally tall.
	const overview = document.querySelector<HTMLElement>('.overview');
	const balanceOverview = () => {
		if (!overview || overview.children.length < 2) return;
		overview.style.gridTemplateColumns = '';
		if (!matchMedia('(min-width: 96rem)').matches) return;
		const [hero, ideas] = [...overview.children] as HTMLElement[];
		overview.style.alignItems = 'start';
		let lo = 0.3; // hero share of the width
		let hi = 0.7;
		for (let i = 0; i < 12; i++) {
			const f = (lo + hi) / 2;
			overview.style.gridTemplateColumns = `${f}fr ${1 - f}fr`;
			if (hero.offsetHeight > ideas.offsetHeight) lo = f; // hero taller: give it more width
			else hi = f;
		}
		overview.style.gridTemplateColumns = `${hi}fr ${1 - hi}fr`;
		overview.style.alignItems = '';
	};
	const balanceAll = () => {
		balanceOverview();
		document.querySelectorAll<HTMLElement>('.flow .card[data-max-h]').forEach((c) => delete c.dataset.maxH);
		layoutFlows();
	};

	// Zoom: click (or Enter) on a picture or code block opens it full screen, pictures at their
	// full resolution. In there, a click on the picture toggles fit-to-screen; a click anywhere
	// else, or Escape, closes it.
	const zoom = document.createElement('dialog');
	zoom.className = 'zoom';
	zoom.setAttribute('aria-label', 'Enlarged view');
	document.body.append(zoom);
	const markZoomable = () =>
		document.querySelectorAll<HTMLElement>('.board .hero-image, .board .card img, .board .card pre').forEach((el) => {
			el.classList.add('zoomable');
			el.tabIndex = 0;
			el.removeAttribute('aria-hidden');
			el.setAttribute('role', 'button');
			const what = el.matches('.hero-image') ? 'project picture' : el.getAttribute('alt') || 'code';
			el.setAttribute('aria-label', `Enlarge ${what}`);
			// cards: each picture / code block gets a wrapper holding its own badge, so the badge
			// stays on it wherever layout moves it (the hero has its badge in the markup)
			if (el.matches('.hero-image') || el.parentElement!.classList.contains('zoom-wrap')) return;
			const wrap = document.createElement('span');
			wrap.className = 'zoom-wrap';
			// the picture's size cap (set by SectionCards) moves to the wrapper, so the badge sits on its corner
			wrap.style.maxWidth = el.style.maxWidth;
			el.style.maxWidth = '';
			const badge = document.createElement('span');
			badge.className = 'zoom-badge';
			badge.setAttribute('aria-hidden', 'true');
			el.before(wrap);
			wrap.append(el, badge);
		});
	markZoomable();
	const open = (el: HTMLElement) => {
		const copy = el.cloneNode(true) as HTMLElement;
		// a bare copy: the page's own classes, scoping attributes and sizes stay behind
		[...copy.attributes]
			.filter((a) => a.name.startsWith('data-astro') || ['class', 'style', 'tabindex', 'role', 'aria-label', 'loading'].includes(a.name))
			.forEach((a) => copy.removeAttribute(a.name));
		// pictures open straight at full resolution, scrolled to their centre
		if (copy instanceof HTMLImageElement) copy.classList.add('actual');
		zoom.replaceChildren(copy);
		zoom.showModal();
		const centre = () => zoom.scrollTo((zoom.scrollWidth - zoom.clientWidth) / 2, (zoom.scrollHeight - zoom.clientHeight) / 2);
		if (copy instanceof HTMLImageElement && !copy.complete) copy.addEventListener('load', centre, { once: true });
		else centre();
		if (copy instanceof HTMLVideoElement) copy.play().catch(() => {});
	};
	document.addEventListener('click', (e) => {
		const el = (e.target as Element).closest<HTMLElement>('.zoomable');
		if (el) open(el);
	});
	document.addEventListener('keydown', (e) => {
		const el = (e.target as Element).closest?.<HTMLElement>('.zoomable');
		if (el && (e.key === 'Enter' || e.key === ' ')) {
			e.preventDefault();
			open(el);
		}
	});
	zoom.addEventListener('click', (e) => {
		const target = e.target as HTMLElement;
		if (target instanceof HTMLImageElement || target instanceof HTMLVideoElement) target.classList.toggle('actual');
		else if (!target.closest('pre')) zoom.close();
	});
	let width = 0;
	new ResizeObserver(([entry]) => {
		if (entry.contentRect.width === width) return; // our own height changes don't need a re-run
		width = entry.contentRect.width;
		balanceAll();
	}).observe(document.querySelector('.board')!);
	document.querySelectorAll('.flow img').forEach((img) => img.addEventListener('load', balanceAll, { once: true }));
	wide.addEventListener('change', balanceAll);
</script>

<style>
	/* blocks top to bottom: the overview bento, Challenges, then the long-form rows */
