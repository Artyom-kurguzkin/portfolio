---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { Content } = await render(project);

const tints = ['var(--tint-blue)', 'var(--tint-coral)', 'var(--tint-periwinkle)'];
---

<Layout title={project.data.title} description={project.data.summary}>
	<a class="back" href={`${import.meta.env.BASE_URL}`} aria-label="Back to main page">&larr;</a>

	<div class="panel">
		{
			project.data.image && (
				<img
					class="cover"
					src={`${import.meta.env.BASE_URL}${project.data.image.replace(/^\//, '')}`}
					alt=""
				/>
			)
		}
		{project.data.category.map((c) => <span class="pill category" style="background:var(--color-blue)">{c}</span>)}
		<h1>{project.data.title}</h1>
		<p class="summary">{project.data.summary}</p>
		{
			project.data.stack.length > 0 && (
				<ul class="stack">
					{project.data.stack.map((tech, i) => (
						<li class="pill" style={`background:${tints[i % tints.length]}`}>
							{tech}
						</li>
					))}
				</ul>
			)
		}
		{
			project.data.link && (
				<p>
					<a class="pill" href={project.data.link} style="background:var(--color-yellow)">
						{project.data.link}
					</a>
				</p>
			)
		}
		<Content />
	</div>
</Layout>

<style>
	.cover {
		width: 100%;
		max-height: 16rem;
		object-fit: cover;
		border-radius: var(--radius-md);
		margin-bottom: 1.25rem;
	}

	.category {
		color: #fff;
		font-weight: 700;
		margin: 0 0.3rem 0.75rem 0;
	}

	h1 {
		color: var(--color-blue);
	}

	.summary {
		color: var(--color-muted);
	}

	.stack {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		padding: 0;
		margin: 0.75rem 0;
	}
</style>
