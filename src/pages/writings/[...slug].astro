---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

// only posts hosted here get a page; ones with an external `link` open that site instead
export async function getStaticPaths() {
	const writings = await getCollection('writings', (post) => !post.data.link);
	return writings.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);
const date = post.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Layout title={post.data.title} description={post.data.summary}>
	<a class="back" href={`${import.meta.env.BASE_URL}`} aria-label="Back to main page"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" /></svg></a>

	<!-- a header card, then one card per "## entry" of the post, all in one grid -->
	<article class="board">
		<header class="panel head">
		<dl class="facts">
			<div>
				<dt>Date</dt>
				<dd><time datetime={post.data.date.toISOString()}>{date}</time></dd>
			</div>
		</dl>
		<h1>{post.data.title}</h1>
		{post.data.summary && <p class="summary">{post.data.summary}</p>}
		</header>
		<div class="entries">
			<Content />
		</div>
	</article>
</Layout>

<script>
	// each "## entry" (its heading and everything up to the next one) becomes its own card
	const entries = document.querySelector('.entries')!;
	for (const h of [...entries.querySelectorAll(':scope > h2')]) {
		const card = document.createElement('section');
		card.className = 'panel';
		h.before(card);
		let node: ChildNode | null = h;
		while (node && !(node !== h && node instanceof HTMLHeadingElement && node.tagName === 'H2')) {
			const next: ChildNode | null = node.nextSibling;
			card.append(node);
			node = next;
		}
	}

	// a YouTube link alone on its own line becomes an embedded player (commentary stays as written around it)
	const YT = /(?:youtube\.com\/watch\?v=|youtu\.be\/)([\w-]{11})/;
	for (const a of document.querySelectorAll<HTMLAnchorElement>('article p > a:only-child')) {
		const id = a.href.match(YT)?.[1];
		if (!id || a.parentElement!.textContent!.trim() !== a.textContent!.trim()) continue;
		const frame = document.createElement('iframe');
		frame.src = `https://www.youtube-nocookie.com/embed/${id}`;
		frame.title = a.textContent!;
		frame.loading = 'lazy';
		frame.allow = 'encrypted-media; picture-in-picture; fullscreen';
		frame.className = 'video';
		a.parentElement!.replaceWith(frame);
	}
</script>

<style>
	/* same width and gaps as the project pages */
	/* header and entry cards share one grid, as many across as fit; every entry holds a 16:9
	   player, so a row comes out even, and the header fills the first cell instead of a whole row */
	.board {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr));
		gap: 1.25rem;
		max-width: 68rem;
		margin: clamp(1rem, 4vw, 2rem) auto;
	}

	@media (min-width: 96rem) {
		.board {
			max-width: min(120rem, 100% - 8rem); /* gutter clears the back button */
		}
	}

	.board :global(.panel) {
		margin: 0;
		max-width: none;
	}

	.entries {
		display: contents;
	}

	.entries :global(h2) {
		margin: 0 0 0.75rem;
		font-size: 1.1rem;
	}

	.entries :global(.panel > :last-child) {
		margin-bottom: 0;
	}

	.head > :last-child {
		margin-bottom: 0;
	}

	article :global(.video) {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
		border: 0;
		border-radius: var(--radius-md);
		margin: 1rem 0;
	}

	/* same facts row as project pages */
	.facts {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 1.75rem;
		margin: 0 0 1.5rem;
		font-size: 0.85rem;
	}

	.facts div {
		display: flex;
		gap: 0.5rem;
		align-items: baseline;
	}

	.facts dt {
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	.facts dd {
		margin: 0;
		color: var(--color-muted);
	}

	h1 {
		color: var(--color-blue);
		margin-top: 0.5rem;
	}

	.summary {
		color: var(--color-muted);
	}
</style>
