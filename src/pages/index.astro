---
import { getCollection } from 'astro:content';
import { ORGANISATIONS, PROJECT_CATEGORIES } from '../content.config';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { Content as AboutContent } from '../data/about.md';
import { Content as ContactContent } from '../data/contact.md';
import { Content as ExpertiseContent } from '../data/expertise.md';

const projects = (await getCollection('projects')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const writings = (await getCollection('writings')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout title="Home">
	<div class="board">
		<div class="panel about">
			<AboutContent />
		</div>

		<div class="panel contact">
			<h2>Contact</h2>
			<ContactContent />
		</div>

		<details class="panel fold expertise">
			<summary><h2>Areas of Expertise</h2></summary>
			<ExpertiseContent />
		</details>
		<!-- inline so it's open before first paint on wider screens; stays folded on mobile -->
		<script is:inline>
			if (matchMedia('(min-width: 40rem)').matches) document.querySelector('.expertise').open = true;
		</script>

		<div class="panel projects">
			<h2>
				Projects <span class="pill count" style="background:var(--color-blue)">{projects.length}</span>
			</h2>

			<div class="controls">
				<div class="filters" role="group" aria-label="Filter by category">
					<!-- "All" is also the sort menu: clicking it shows every project and opens the
					     sort order. The <button> child sets the label (customizable select, Chromium). -->
					<select id="sort" class="chip active" data-filter="all" aria-label="All projects, sort order">
						<button>All</button>
						<option value="date-desc">Newest</option>
						<option value="date-asc">Oldest</option>
						<option value="title-asc">Title A–Z</option>
					</select>
					<!-- the button label is swapped to the chosen organisation by the script below -->
					<select id="org" class="chip" aria-label="Filter by organisation">
						<button>Organisation</button>
						<option value="">All organisations</option>
						{ORGANISATIONS.map((org) => <option value={org}>{org}</option>)}
					</select>
					{
						PROJECT_CATEGORIES.map((category) => (
							<button type="button" class="chip" data-filter={category}>
								{category}
							</button>
						))
					}
				</div>
			</div>

			<div class="gallery" id="gallery" tabindex="-1">
				{projects.map((project, index) => <ProjectCard project={project} index={index} />)}
			</div>
		</div>

		<div class="panel writings">
			<h2>
				Writings <span class="pill count" style="background:var(--color-coral)">{writings.length}</span>
			</h2>
			<ul class="writing-list">
				{
					writings.map((post) => (
						<li>
							{post.data.link ? (
								<a href={post.data.link} target="_blank" rel="noopener noreferrer">
									{post.data.title}
								</a>
							) : (
								<a href={`${import.meta.env.BASE_URL}writings/${post.id}/`}>{post.data.title}</a>
							)}
							{post.data.summary && <p>{post.data.summary}</p>}
						</li>
					))
				}
			</ul>
		</div>
	</div>
</Layout>

<script>
	const gallery = document.getElementById('gallery')!;
	const chips = document.querySelectorAll<HTMLElement>('.chip[data-filter]');
	const sortSelect = document.getElementById('sort') as HTMLSelectElement;
	const orgSelect = document.getElementById('org') as HTMLSelectElement;

	function applyFilter() {
		const active = document.querySelector('.chip.active[data-filter]')?.getAttribute('data-filter') ?? 'all';
		const org = orgSelect.value;
		// drive which details the tiles show (see .meta in ProjectCard.astro)
		gallery.classList.toggle('cat-filtered', active !== 'all');
		gallery.classList.toggle('org-filtered', org !== '');
		for (const tile of gallery.children) {
			const el = tile as HTMLElement;
			const hidden = (active !== 'all' && !el.dataset.category!.split(' ').includes(active)) || (org !== '' && el.dataset.org !== org);
			el.classList.toggle('is-hidden', hidden);
		}
	}

	function applySort() {
		const [key, dir] = sortSelect.value.split('-');
		const tiles = [...gallery.children] as HTMLElement[];
		tiles.sort((a, b) => {
			const cmp =
				key === 'date'
					? new Date(a.dataset.date ?? 0).getTime() - new Date(b.dataset.date ?? 0).getTime()
					: (a.dataset.title ?? '').localeCompare(b.dataset.title ?? '');
			return dir === 'desc' ? -cmp : cmp;
		});
		tiles.forEach((tile) => gallery.append(tile));
	}

	function setOrg(org: string) {
		orgSelect.value = org;
		orgSelect.querySelector('button')!.textContent = org || 'Organisation';
		orgSelect.classList.toggle('active', org !== '');
		applyFilter();
	}

	// "All" resets only the category; a chosen organisation stays (clear it via "All organisations")
	function setFilter(category: string) {
		chips.forEach((c) => c.classList.toggle('active', c.dataset.filter === category));
		applyFilter();
	}

	orgSelect.addEventListener('change', () => setOrg(orgSelect.value));

	chips.forEach((chip) => {
		chip.addEventListener('click', () => setFilter(chip.dataset.filter!));
	});

	// expertise links are written as [**Area**](#filter-Category) in expertise.md
	document.querySelector('.expertise')!.addEventListener('click', (e) => {
		const link = (e.target as Element).closest<HTMLAnchorElement>('a[href^="#filter-"]');
		if (!link) return;
		e.preventDefault();
		setFilter(link.hash.slice('#filter-'.length));
		gallery.focus();
	});

	// picking a sort order from the All menu also means "show all"
	sortSelect.addEventListener('change', () => {
		setFilter('all');
		applySort();
	});
</script>

<style>
	.board {
		display: grid;
		gap: 1.25rem;
		max-width: var(--content-width);
		margin-inline: auto;
		grid-template-columns: 1fr;
		grid-template-areas:
			'about'
			'contact'
			'expertise'
			'projects'
			'writings';
	}

	/* tablet: About beside Contact; long Expertise gets a full row */
	@media (min-width: 40rem) {
		.board {
			grid-template-columns: 1fr 1fr;
			grid-template-areas:
				'about contact'
				'expertise expertise'
				'projects projects'
				'writings writings';
		}
	}

	/* desktop: About is the lead block beside Contact */
	@media (min-width: 60rem) {
		.board {
			max-width: 68rem;
			grid-template-columns: 1fr 1fr 1fr;
			grid-template-areas:
				'about about contact'
				'expertise expertise expertise'
				'projects projects writings';
		}
	}

	.panel {
		margin: 0;
		max-width: none;
	}

	.about {
		grid-area: about;
	}

	.about :global(h1) {
		color: var(--color-coral);
	}

	/* drawn 😊 (an emoji glyph can't be recoloured); currentColor keeps it the heading's colour */
	.about :global(.smiley) {
		width: 0.8em;
		height: 0.8em;
		vertical-align: -0.06em;
		fill: none;
		stroke: currentColor;
		stroke-width: 2.2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.contact {
		grid-area: contact;
	}

	.contact h2 {
		color: var(--color-periwinkle);
	}

	/* label above value: one left edge for every row, and the long email never wraps under a label */
	.contact :global(dl) {
		margin: 1rem 0 0;
	}

	/* small bold caps in the card's text colour, so the labels read as designed, not default */
	.contact :global(dt) {
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-ink);
		margin-bottom: 0.15rem;
	}

	.contact :global(dd) {
		margin: 0 0 0.85rem;
		overflow-wrap: anywhere;
	}

	.contact :global(dd:last-child) {
		margin-bottom: 0;
	}

	.expertise {
		grid-area: expertise;
	}

	.expertise h2 {
		color: var(--color-blue);
	}

	.expertise :global(ul) {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(22rem, 100%), 1fr));
		gap: 0 2.5rem;
		padding-left: 1.1rem;
		margin: 0.5rem 0 0;
	}

	.expertise :global(li) {
		margin-bottom: 0.4rem;
	}

	.expertise :global(li p) {
		margin: 0;
	}

	.fold summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		cursor: pointer;
		list-style: none;
	}

	.fold summary::-webkit-details-marker {
		display: none;
	}

	.fold summary h2 {
		margin: 0;
	}

	.fold summary::after {
		content: '';
		flex: none;
		width: 0.85rem;
		height: 0.85rem;
		margin-right: 0.35rem;
		border-right: 3.5px solid currentColor;
		border-bottom: 3.5px solid currentColor;
		border-radius: 2px;
		transform: translateY(-25%) rotate(45deg);
	}

	.fold[open] summary::after {
		transform: translateY(25%) rotate(-135deg);
	}

	.fold summary:hover::after {
		color: var(--color-green);
	}

	.fold summary::after {
		transition: color 0.15s ease, transform 0.25s ease;
	}

	/* hover nudges the chevron in the direction it will move */
	.fold:not([open]) summary:hover::after {
		transform: translateY(0) rotate(45deg);
	}

	.fold[open] summary:hover::after {
		transform: translateY(0) rotate(-135deg);
	}

	.fold[open] summary {
		margin-bottom: 0.5rem;
	}

	/* whole item is the click target: stretch the link over its <li> */
	.expertise :global(li) {
		position: relative;
		padding: 0.35rem 0.5rem;
		border-radius: var(--radius-md);
		cursor: pointer;
	}

	.expertise :global(li a) {
		text-decoration: none;
	}

	.expertise :global(li a::after) {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: var(--radius-md);
	}

	.expertise :global(li:hover),
	.expertise :global(li:has(a:focus-visible)) {
		--sk-line: transparent;
		--sk-dash: var(--dash-box);
	}

	.expertise :global(li a:focus-visible) {
		outline: none;
	}

	.projects {
		grid-area: projects;
	}

	.projects h2 {
		color: var(--color-periwinkle);
	}

	.writings {
		grid-area: writings;
	}

	.writings h2 {
		color: var(--color-coral);
	}

	h2 {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}

	.count {
		font-size: 0.75rem;
		font-weight: 700;
		color: #fff;
	}

	.controls {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
		margin: 1rem 0;
	}

	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.chip {
		font: inherit;
		border: 1px solid transparent;
		--sk-line: color-mix(in srgb, var(--color-ink) 22%, transparent);
		--sk-fill: var(--color-surface);
		border-radius: 999px;
		padding: 0.3rem 0.85rem;
		font-size: 0.85rem;
		background: none;
		color: var(--color-ink);
	}

	.chip {
		cursor: pointer;
	}

	/* ponytail: customizable <select> (Chromium); other browsers keep the native popup */
	select.chip,
	select.chip::picker(select) {
		appearance: base-select;
	}

	select.chip:focus-visible {
		outline: none;
		--sk-line: transparent;
		--sk-dash: var(--dash-pill);
	}

	select.chip {
		cursor: pointer;
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}

	select.chip::picker(select) {
		position-area: block-end span-inline-end;
		position-try-order: normal;
		margin-top: 0.35rem;
		padding: 0.3rem;
		overflow: hidden;
		border: var(--border-card);
		border-radius: var(--radius-md);
		background: var(--color-surface);
		box-shadow: 0 8px 24px rgba(23, 23, 28, 0.08);
	}

	select.chip option {
		/* the outline vars inherit from the select; options start bare */
		--sk-line: transparent;
		--sk-fill: transparent;
		--sk-w: 1px;
		--sk-dash: none;
		background: none;
		color: var(--color-ink);
		padding: 0.35rem 0.85rem;
		border-radius: 999px;
		font-size: 0.85rem;
		cursor: pointer;
	}

	select.chip option::checkmark {
		display: none;
	}

	select.chip option:hover,
	select.chip option:focus-visible {
		outline: none;
		--sk-line: transparent;
		--sk-dash: var(--dash-pill);
	}

	select.chip option:checked {
		--sk-fill: var(--color-green);
		color: #fff;
	}

	.chip.active,
	.chip.active:hover {
		--sk-fill: var(--color-green);
		--sk-line: var(--color-green);
		--sk-dash: none;
		color: #fff;
	}

	.chip:hover {
		--sk-line: transparent;
		--sk-dash: var(--dash-pill);
	}

	.chip:focus-visible {
		outline: none;
		--sk-line: transparent;
		--sk-dash: var(--dash-pill);
	}

	/* empty state when the filters match nothing */
	.gallery:not(:has(> :not(.is-hidden)))::before {
		content: 'No projects match these filters yet.';
		grid-column: 1 / -1;
		color: var(--color-muted);
	}

	.gallery {
		container: gallery / inline-size;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
		gap: 1rem;
	}

	/* list view once more than 6 tiles are visible (counts only unfiltered ones); rows in ProjectCard.astro */
	.gallery:has(> :nth-child(7 of :not(.is-hidden))) {
		grid-template-columns: 1fr;
		gap: 0.5rem;
	}

	.writing-list {
		list-style: none;
		padding: 0;
		margin: 1rem 0 0;
	}

	/* whole row is the click target, same as expertise items */
	.writing-list li {
		position: relative;
		padding: 0.75rem;
		border-radius: var(--radius-md);
	}

	.writing-list li:not(:last-child)::after {
		content: '';
		position: absolute;
		left: 0.75rem;
		right: 0.75rem;
		bottom: 0;
		border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 10%, transparent);
		pointer-events: none;
	}

	.writing-list li:hover,
	.writing-list li:has(a:focus-visible) {
		--sk-line: transparent;
		--sk-dash: var(--dash-box);
	}

	.writing-list a::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: var(--radius-md);
	}

	.writing-list a {
		font-weight: 600;
		text-decoration: none;
	}

	/* override the global orange link hover; the green border is the emphasis */
	.writing-list a:hover {
		color: var(--color-blue);
	}

	.writing-list a:focus-visible {
		outline: none;
	}

	.writing-list p {
		margin: 0.25rem 0 0;
		color: var(--color-muted);
	}

	.chip {
		transition: color 0.3s ease;
	}
</style>
