---
import { getCollection } from 'astro:content';
import { ORGANISATIONS, PROJECT_CATEGORIES } from '../content.config';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { Content as AboutContent } from '../data/about.md';
import { Content as ContactContent } from '../data/contact.md';
import photos from '../data/instagram.json'; // written by scripts/instagram.mjs before dev/build
import Zoom from '../components/Zoom.astro';

const projects = (await getCollection('projects', (p) => !p.data.draft)).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const assets = import.meta.glob<{ default: ImageMetadata }>('../assets/**/*.{png,jpg,jpeg,webp}', { eager: true, import: 'default' }) as unknown as Record<string, ImageMetadata>;
// gallery: Instagram photos plus each project's hero picture (which links back to its project)
const url = (path: string) => `${import.meta.env.BASE_URL}${path.replace(/^\//, '')}`;
const gallery = [
	...photos.map((p) => ({ src: url(p.src), alt: p.caption.split(String.fromCharCode(10))[0] || 'Photo', project: undefined })),
	...projects.flatMap((p) => {
		const project = url(`projects/${p.id}/`);
		// the hero, then every picture in the page body (local ones; their files come from src/assets)
		const body = [...(p.body ?? '').matchAll(/!\[([^\]]*)\]\(\.\.\/\.\.\/assets\/([^)]+)\)/g)]
			.map(([, alt, path]) => ({ src: assets[`../assets/${path}`]?.src, alt, project }))
			.filter((g) => g.src);
		return [...(p.data.image ? [{ src: url(p.data.image), alt: p.data.title, project }] : []), ...body];
	}),
];
const writings = (await getCollection('writings')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout title="Home">
	<div class="board">
		<div class="panel about">
			<AboutContent />
			<div class="contact">
				<ContactContent />
			</div>
		</div>


		<div class="panel projects">
			<h2>
				Projects <span class="pill count" style="background:var(--color-green)">{projects.length}</span>
			</h2>

			<div class="controls">
				<div class="filters" role="group" aria-label="Filter by category">
					<!-- the button label is swapped to the chosen organisation by the script below -->
					<select id="org" class="chip" aria-label="Filter by organisation">
						<button>Organisation</button>
						<option value="">All</option>
						{ORGANISATIONS.map((org) => <option value={org}>{org}</option>)}
					</select>
					{
						PROJECT_CATEGORIES.map((category) => (
							<button type="button" class="chip" data-filter={category}>
								{category}
							</button>
						))
					}
				</div>
			</div>

			<div class="gallery" id="gallery" tabindex="-1">
				{projects.map((project, index) => <ProjectCard project={project} index={index} />)}
			</div>
		</div>

		<div class="panel writings">
			<h2>
				Writings <span class="pill count" style="background:var(--color-yellow);color:var(--color-ink)">{writings.length}</span>
			</h2>
			<ul class="writing-list">
				{
					writings.map((post) => (
						<li>
							{post.data.link ? (
								<a href={post.data.link} target="_blank" rel="noopener noreferrer">
									{post.data.title}
								</a>
							) : (
								<a href={`${import.meta.env.BASE_URL}writings/${post.id}/`}>{post.data.title}</a>
							)}
							{post.data.summary && <p>{post.data.summary}</p>}
						</li>
					))
				}
			</ul>
		</div>

		{
			gallery.length > 0 && (
				<div class="panel photos">
					<h2>
						Photos <span class="pill count" style="background:var(--color-yellow);color:var(--color-ink)">{gallery.length}</span>
						<!-- opens the gallery (script below), then goes away -->
						<button type="button" class="back gallery-button" aria-expanded="false" aria-controls="bento" aria-label="Show photos">
							<svg class="icon-open" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6" /></svg>
						</button>
					</h2>
					<!-- bento: hidden (and its photos not loaded) until opened; shuffled and sized by the script
					     below; dense packing fills the gaps -->
					<div class="bento" id="bento" hidden>
						{gallery.map((g) => (
							<span class="zoom-wrap">
								<img
									class="zoomable"
									data-zoom={g.project ? undefined : 'fit'}
									data-project={g.project}
									tabindex="0"
									role="button"
									data-src={g.src}
									alt={g.alt}
									loading="lazy"
								/>
								<span class="zoom-badge" aria-hidden="true" />
							</span>
						))}
					</div>
				</div>
			)
		}
	</div>
	<Zoom />
</Layout>

<script>
	// Photos bento. Closed on arrival (its photos aren't even requested); the arrow button opens it:
	// the tiles pop in, then shuffle once. Every shuffle re-sizes the tiles with a repeating pattern of
	// big, wide and tall tiles (every 10 tiles fill 3 rows of 6, or 6 rows of 3 on phones), and the
	// tiles glide from their old places to the new ones.
	const bento = document.querySelector<HTMLElement>('.bento');
	const galleryButton = document.querySelector<HTMLButtonElement>('.gallery-button');
	// Blocks that each fill whole rows at both 6 and 3 columns, so the grid always closes:
	// the main 10-tile block (3 rows of 6), and row blocks of 6, 5 or 4 tiles (1 row of 6).
	const MAIN = ['big', 'one', 'one', 'wide', 'one', 'one', 'tall', 'one', 'big', 'one'];
	const ROW: Record<number, string[]> = {
		6: ['one', 'one', 'one', 'one', 'one', 'one'],
		5: ['wide', 'one', 'one', 'one', 'one'],
		4: ['wide', 'one', 'wide', 'one'],
	};
	// what's left after the main blocks, as row blocks; 1, 2, 3 and 7 don't split, so one main
	// block is broken up and re-split together with them
	const SPLIT: Record<number, number[]> = { 0: [], 4: [4], 5: [5], 6: [6], 8: [4, 4], 9: [4, 5], 11: [6, 5], 12: [6, 6], 13: [4, 4, 5], 17: [6, 6, 5] };
	const shuffle = (bento: HTMLElement) => {
		const tiles = [...bento.children] as HTMLElement[];
		for (let i = tiles.length - 1; i > 0; i--) {
			const j = Math.floor(Math.random() * (i + 1));
			[tiles[i], tiles[j]] = [tiles[j], tiles[i]];
		}
		let mains = Math.floor(tiles.length / 10);
		let rest = tiles.length % 10;
		if (!SPLIT[rest] && mains > 0) {
			mains--;
			rest += 10;
		}
		const sizes = [...Array(mains).fill(MAIN).flat(), ...(SPLIT[rest] ?? [rest]).flatMap((n) => ROW[n] ?? Array(n).fill('one'))];
		tiles.forEach((t, i) => {
			t.className = `zoom-wrap tile-${sizes[i]}`;
			bento.append(t);
		});
	};
	// FLIP: each tile starts drawn where it was and moves to where it is now
	const shuffleAnimated = (bento: HTMLElement) => {
		const tiles = [...bento.children] as HTMLElement[];
		const before = new Map(tiles.map((t) => [t, t.getBoundingClientRect()]));
		shuffle(bento);
		for (const t of tiles) {
			const a = before.get(t)!;
			const b = t.getBoundingClientRect();
			if (!b.width) continue;
			t.animate(
				[{ transformOrigin: 'top left', transform: `translate(${a.left - b.left}px, ${a.top - b.top}px) scale(${a.width / b.width}, ${a.height / b.height})` }, { transformOrigin: 'top left', transform: 'none' }],
				{ duration: 600, easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)' }
			);
		}
	};
	if (bento && galleryButton) {
		shuffle(bento);
		// the whole collapsed card opens it (the button stays as the keyboard way in)
		const card = bento.closest<HTMLElement>('.photos')!;
		card.classList.add('collapsed');
		const openGallery = () => {
			if (!card.classList.contains('collapsed')) return;
			card.classList.remove('collapsed');
			bento.querySelectorAll<HTMLImageElement>('img[data-src]').forEach((img) => (img.src = img.dataset.src!));
			bento.hidden = false;
			galleryButton.remove(); // focus would otherwise fall to <body>
			bento.querySelector<HTMLElement>('img')?.focus({ preventScroll: true });
			// opening: tiles pop in one after another, in reading order, then the gallery shuffles once
			// the whole cascade takes POP_MS however many tiles there are, so the shuffle follows straight on
			const POP_MS = 600;
			const tiles = [...bento.children];
			const pops = tiles.map((t, i) =>
				t.animate([{ opacity: 0, transform: 'translateY(-1.5rem) scale(0.85)' }, { opacity: 1, transform: 'none' }], {
					duration: 300,
					delay: (i / tiles.length) * (POP_MS - 300),
					easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)',
					fill: 'backwards',
				})
			);
			Promise.all(pops.map((a) => a.finished)).then(() => shuffleAnimated(bento));
		};
		card.addEventListener('click', openGallery);
	}

	// "Hi, I'm Artyom 😊": every symbol gets its own colour, never the same as its neighbours,
	// re-picked every PERIOD_MS. Symbols are split across 4 timers that start OFFSET_MS apart.
	const PALETTE = ['var(--color-blue)', 'var(--color-green)', 'var(--color-yellow)'];
	const PERIOD_MS = 200;
	const OFFSET_MS = 25; // ponytail: 25ms reads as simultaneous; PERIOD_MS / 4 spreads the groups evenly
	const heading = document.querySelector<HTMLElement>('.about h1')!;
	heading.setAttribute('aria-label', heading.textContent!.trim());
	for (const node of [...heading.childNodes]) {
		if (node.nodeType !== Node.TEXT_NODE) continue;
		const letters = [...node.textContent!].map((ch) => {
			const span = document.createElement('span');
			span.textContent = ch;
			if (ch.trim()) span.className = 'sym';
			return span;
		});
		node.replaceWith(...letters);
	}
	heading.querySelector('svg')?.classList.add('sym');
	const symbols = [...heading.querySelectorAll<HTMLElement | SVGElement>('.sym')];
	symbols.forEach((s) => s.setAttribute('aria-hidden', 'true'));

	const recolor = (i: number) => {
		const taken = [symbols[i - 1], symbols[i + 1]].map((s) => s?.style.color);
		const options = PALETTE.filter((c) => c !== symbols[i].style.color && !taken.includes(c));
		// both neighbours may already hold the other two colours: then keep the current one this round
		if (options.length) symbols[i].style.color = options[Math.floor(Math.random() * options.length)];
	};
	symbols.forEach((_, i) => recolor(i));
	for (let group = 0; group < 4; group++) {
		const members = symbols.map((_, i) => i).filter((i) => i % 4 === group);
		setTimeout(() => setInterval(() => members.forEach(recolor), PERIOD_MS), group * OFFSET_MS);
	}

	const gallery = document.getElementById('gallery')!;
	const chips = document.querySelectorAll<HTMLElement>('.chip[data-filter]');
	const orgSelect = document.getElementById('org') as HTMLSelectElement;

	function applyFilter() {
		const active = document.querySelector('.chip.active[data-filter]')?.getAttribute('data-filter') ?? 'all';
		const org = orgSelect.value;
		// with an organisation picked, tiles drop it from their details (see .org in ProjectCard.astro)
		gallery.classList.toggle('org-filtered', org !== '');
		for (const tile of gallery.children) {
			const el = tile as HTMLElement;
			const hidden = (active !== 'all' && !el.dataset.category!.split(' ').includes(active)) || (org !== '' && el.dataset.org !== org);
			el.classList.toggle('is-hidden', hidden);
		}
	}

	function setOrg(org: string) {
		orgSelect.value = org;
		orgSelect.querySelector('button')!.textContent = org || 'Organisation';
		orgSelect.classList.toggle('active', org !== '');
		applyFilter();
	}

	// at most one category; 'all' (no chip active) shows every category
	function setFilter(category: string) {
		chips.forEach((c) => c.classList.toggle('active', c.dataset.filter === category));
		applyFilter();
	}

	orgSelect.addEventListener('change', () => setOrg(orgSelect.value));

	chips.forEach((chip) => {
		// clicking the selected category again deselects it
		chip.addEventListener('click', () => setFilter(chip.classList.contains('active') ? 'all' : chip.dataset.filter!));
	});
</script>

<style>
	.board {
		display: grid;
		gap: 1.25rem;
		max-width: var(--content-width);
		margin-inline: auto;
		grid-template-columns: 1fr;
		grid-template-areas:
			'about'
			'projects'
			'writings'
			'photos';
	}

	/* tablet: About on top */
	@media (min-width: 40rem) {
		.board {
			grid-template-columns: 1fr 1fr;
			grid-template-areas:
				'about about'
				'projects projects'
				'writings writings'
				'photos photos';
		}
	}

	/* desktop: About is a full-width lead block */
	@media (min-width: 60rem) {
		.board {
			max-width: 68rem;
			grid-template-columns: 1fr 1fr 1fr;
			grid-template-areas:
				'about about about'
				'projects projects writings'
				'photos photos photos';
		}
	}

	.panel {
		margin: 0;
		max-width: none;
	}

	.about {
		grid-area: about;
	}

	.about :global(h1) {
		color: var(--color-blue);
	}

	/* per-symbol colours are set by the script above; a short fade */
	.about :global(.sym) {
		transition: color 0.08s ease-in-out;
	}

	/* thin dark outline on the greeting's letters (not the smiley); keeps yellow readable */
	.about :global(span.sym) {
		-webkit-text-stroke: 1px var(--color-ink);
		paint-order: stroke fill;
	}

	/* drawn 😊 (an emoji glyph can't be recoloured); currentColor keeps it the heading's colour */
	.about :global(.smiley) {
		width: 0.8em;
		height: 0.8em;
		vertical-align: -0.06em;
		fill: none;
		stroke: currentColor;
		stroke-width: 2.2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	/* contact sits at the bottom of the About card */
	.contact {
		margin-top: 1.5rem;
		padding-top: 1.25rem;
		border-top: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent);
	}

	.contact :global(p) {
		margin: 0;
		overflow-wrap: anywhere;
	}

	.projects {
		grid-area: projects;
	}

	.projects h2 {
		color: var(--color-green);
	}

	.photos {
		grid-area: photos;
	}

	.photos h2 {
		color: var(--color-yellow);
	}

	.bento[hidden] {
		display: none;
	}

	/* the round yellow arrow next to the title, which bobs on hover */
	.gallery-button {
		width: 2.5rem;
		height: 2.5rem;
		padding: 0;
		border: 0;
		margin-left: auto;
		cursor: pointer;
		/* the shared .back look, minus its phone pinning and hover nudge (relative: its yellow
		   fill is an absolutely placed ::before) */
		position: relative;
		inset: auto;
		box-shadow: none;
		transform: none;
	}

	/* collapsed: the whole card is the button, and hovering it bobs the arrow */
	.photos.collapsed {
		cursor: pointer;
	}

	.photos.collapsed:hover .icon-open,
	.gallery-button:is(:hover, :focus-visible) .icon-open {
		animation: gallery-bob 0.6s ease;
	}

	@keyframes gallery-bob {
		40% {
			transform: translateY(4px);
		}
		70% {
			transform: translateY(-2px);
		}
	}

	/* bento: square cells (row height = column width, via the card's width), some tiles span 2 */
	.photos {
		container-type: inline-size;
	}

	.bento {
		--cols: 3;
		--gap: 0.5rem;
		display: grid;
		grid-template-columns: repeat(var(--cols), 1fr);
		grid-auto-rows: calc((100cqi - (var(--cols) - 1) * var(--gap)) / var(--cols));
		grid-auto-flow: dense;
		gap: var(--gap);
		margin-top: 1rem;
	}

	@container (min-width: 40rem) {
		.bento {
			--cols: 6;
		}
	}

	.bento .tile-big {
		grid-column: span 2;
		grid-row: span 2;
	}

	.bento .tile-wide {
		grid-column: span 2;
	}

	.bento .tile-tall {
		grid-row: span 2;
	}

	/* gallery: the badge only shows (and wiggles) on the hovered photo, or one reached with Tab */
	.bento .zoom-badge {
		display: none;
	}

	.bento .zoom-wrap:is(:hover, :has(:focus-visible)) > .zoom-badge {
		display: block;
	}

	.bento img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: var(--radius-md);
	}

	.writings {
		grid-area: writings;
	}

	.writings h2 {
		color: var(--color-blue);
	}

	h2 {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}

	.count {
		font-size: 0.75rem;
		font-weight: 700;
		color: #fff;
	}

	.controls {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
		margin: 1rem 0;
	}

	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.chip {
		font: inherit;
		border: 1px solid transparent;
		--sk-line: color-mix(in srgb, var(--color-ink) 22%, transparent);
		--sk-fill: var(--color-surface);
		border-radius: 999px;
		padding: 0.3rem 0.85rem;
		font-size: 0.85rem;
		background: none;
		color: var(--color-ink);
	}

	.chip {
		cursor: pointer;
	}

	/* ponytail: customizable <select> (Chromium); other browsers keep the native popup */
	select.chip,
	select.chip::picker(select) {
		appearance: base-select;
	}

	select.chip:focus-visible {
		outline: none;
		--sk-line: transparent;
		--sk-dash: var(--dash-pill);
	}

	select.chip {
		cursor: pointer;
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}

	select.chip::picker(select) {
		position-area: block-end span-inline-end;
		position-try-order: normal;
		margin-top: 0.35rem;
		padding: 0.3rem;
		overflow: hidden;
		border: var(--border-card);
		border-radius: var(--radius-md);
		background: var(--color-surface);
		box-shadow: 0 8px 24px rgba(23, 23, 28, 0.08);
	}

	select.chip option {
		/* the outline vars inherit from the select; options start bare */
		--sk-line: transparent;
		--sk-fill: transparent;
		--sk-w: 1px;
		--sk-dash: none;
		background: none;
		color: var(--color-ink);
		padding: 0.35rem 0.85rem;
		border-radius: 999px;
		font-size: 0.85rem;
		cursor: pointer;
	}

	select.chip option::checkmark {
		display: none;
	}

	select.chip option:hover,
	select.chip option:focus-visible {
		outline: none;
		--sk-line: transparent;
		--sk-dash: var(--dash-pill);
	}

	select.chip option:checked {
		--sk-fill: var(--color-green);
		color: #fff;
	}

	.chip.active,
	.chip.active:hover {
		--sk-fill: var(--color-green);
		--sk-line: var(--color-green);
		--sk-dash: none;
		color: #fff;
	}

	.chip:hover {
		--sk-line: transparent;
		--sk-dash: var(--dash-pill);
	}

	.chip:focus-visible {
		outline: none;
		--sk-line: transparent;
		--sk-dash: var(--dash-pill);
	}

	/* empty state when the filters match nothing */
	.gallery:not(:has(> :not(.is-hidden)))::before {
		content: 'No projects match these filters yet.';
		grid-column: 1 / -1;
		color: var(--color-muted);
	}

	.gallery {
		container: gallery / inline-size;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
		gap: 1rem;
	}

	/* list view once more than 6 tiles are visible (counts only unfiltered ones); rows in ProjectCard.astro */
	.gallery:has(> :nth-child(7 of :not(.is-hidden))) {
		grid-template-columns: 1fr;
		gap: 0.5rem;
	}

	.writing-list {
		list-style: none;
		padding: 0;
		margin: 1rem 0 0;
	}

	/* whole row is the click target */
	.writing-list li {
		position: relative;
		padding: 0.75rem;
		border-radius: var(--radius-md);
	}

	.writing-list li:not(:last-child)::after {
		content: '';
		position: absolute;
		left: 0.75rem;
		right: 0.75rem;
		bottom: 0;
		border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 10%, transparent);
		pointer-events: none;
	}

	.writing-list li:hover,
	.writing-list li:has(a:focus-visible) {
		--sk-line: transparent;
		--sk-dash: var(--dash-box);
	}

	.writing-list a::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: var(--radius-md);
	}

	.writing-list a {
		font-weight: 600;
		text-decoration: none;
	}

	/* override the global orange link hover; the green border is the emphasis */
	.writing-list a:hover {
		color: var(--color-blue);
	}

	.writing-list a:focus-visible {
		outline: none;
	}

	.writing-list p {
		margin: 0.25rem 0 0;
		color: var(--color-muted);
	}

	.chip {
		transition: color 0.3s ease;
	}
</style>
